generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model applications {
  application_id        Int       @id @default(autoincrement())
  name                  String?   @db.VarChar(255)
  dob                   DateTime? @db.Date
  gender                String?   @db.VarChar(10)
  nationality           Int?      @default(0)
  email                 String?   @db.VarChar(255)
  code                  Int?
  phone                 String?   @db.VarChar(20)
  second_code           Int?
  second_phone          String?   @db.VarChar(20)
  whatsapp_no           String?   @db.VarChar(20)
  country_id            Int?      @default(0)
  state                 String?   @db.VarChar(100)
  district              String?   @db.VarChar(100)
  address               String?   @db.Text
  status                Boolean?  @default(true)
  cropped_image         String?   @db.Text
  enrollment_date       DateTime? @db.Date
  university_id         Int?
  course_id             Int?
  specialisation_id     Int?
  session_id            Int?
  adm_pipeline          String?   @db.VarChar(100)
  pipeline_user         Int?
  source                String?   @db.VarChar(255)
  admission_status      Boolean?  @default(false)
  custom_application_id String?   @db.VarChar(100)
  abc_id                String?   @db.VarChar(100)
  enrollment_id         String?   @db.VarChar(100)
  amount                Int?
  paid_date             DateTime? @db.Date
  payment_mode          String?   @db.VarChar(100)
  payment_to            String?   @db.VarChar(100)
  fee_receipt           String?   @db.VarChar(255)
  is_archived           Boolean   @default(false)
  is_converted          Int?
  converted_by          Int?
  converted_at          DateTime? @db.DateTime(0)
  created_by            Int?
  created_at            DateTime? @db.DateTime(0)
  updated_by            Int?
  updated_at            DateTime? @db.DateTime(0)
  deleted_at            DateTime? @db.DateTime(0)
  deleted_by            Int?

  /// Workflow stage (migration 002): lead_added | form_pending | counsellor_review |
  /// fee_pending | fee_verification | sa_verification | converted | rejected.
  /// NULL = not yet in the workflow (every legacy row, every LMS insert); the API
  /// derives its stage. status NULL means active, and is_archived = 1 is the LMS
  /// draft flag, never "rejected".
  stage              String?   @db.VarChar(32)
  stage_entered_at   DateTime? @db.DateTime(0)
  /// Non-NULL = On Hold (the stage is kept). Reason and actor live in application_stage_log.
  hold_at            DateTime? @db.DateTime(0)
  hold_followup_date DateTime? @db.Date
  /// normalizeIndianMobile(phone) (src/students/indian-mobile.ts), or NULL when phone is
  /// not a valid Indian mobile (migration 002). The API must set it on every write of
  /// phone; the LMS does not maintain it. Not unique: legacy data has shared numbers.
  phone_normalized   String?   @db.Char(10)
  /// Add Lead "Quick Notes" (migration 002).
  remarks            String?   @db.Text
  /// users.id of whoever referred a Referral lead; same type as students.referred_by.
  referred_by        Int?
  /// intake.id (v2 master) the student applies for (migration 003, IN04). NULL for
  /// legacy rows, which fall back to session_id -> intake.session_id for display.
  intake_id          Int?

  @@index([stage, stage_entered_at], map: "idx_applications_stage")
  @@index([pipeline_user, created_by], map: "idx_applications_owner")
  @@index([phone_normalized], map: "idx_applications_phone_norm")
  @@index([intake_id], map: "idx_applications_intake")
}

